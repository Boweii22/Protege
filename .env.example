# Production model traffic is routed through Vercel AI Gateway. OIDC is automatic on Vercel.
AI_GATEWAY_API_KEY=
AI_TOPIC_MODELS=google/gemini-3.7-flash,anthropic/claude-haiku-4.5,openai/gpt-5.4-mini,google/gemini-2.5-flash-lite
AI_STUDENT_MODELS=anthropic/claude-haiku-4.5,google/gemini-3.7-flash,openai/gpt-5.4-mini,google/gemini-2.5-flash-lite
AI_EXAMINER_MODELS=openai/gpt-5.4,anthropic/claude-sonnet-4.6,google/gemini-3.1-pro-preview,google/gemini-2.5-flash-lite
AI_DIAGNOSIS_MODELS=anthropic/claude-sonnet-4.6,openai/gpt-5.4,google/gemini-3.1-pro-preview,google/gemini-2.5-flash-lite

# Clerk authentication. The publishable key is client-visible; keep the secret server-only.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=https://protege-lac.vercel.app,http://localhost:5173
DATABASE_URL=
